# Record Shelf environment variables.
# Cloudflare Pages: set these in the dashboard / wrangler, not in a committed file.
# Docker / adapter-node: pass at runtime, e.g. `docker run -e DISCOGS_TOKEN=... -e ORIGIN=...`.

# Discogs Personal Access Token (optional).
# If set, used as a fallback when a user hasn't configured their own token.
# Get one at: https://www.discogs.com/settings/developers
# DISCOGS_TOKEN=your_token_here

# adapter-node only: the public https origin the app is served from. Required for
# SvelteKit's CSRF/origin checks behind a proxy. e.g. https://records.example.com
# ORIGIN=https://localhost

# adapter-node only: port the node server listens on (default 3000).
# PORT=3000
